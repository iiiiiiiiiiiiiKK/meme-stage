# MEME STAGE deployment configuration (local shell only — never commit real values)
# ---------------------------------------------------------------------------
# The application itself needs no runtime secrets: the browser talks to the
# same-origin Pages Functions, and ownership is a capability key generated in
# the browser (see src/lib/ids.ts).
#
# These variables are only used by the maintainer when deploying / seeding.

# Cloudflare API token with "Cloudflare Pages:Edit" + "D1:Edit" + "R2:Edit"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# D1 database that backs projects (see wrangler.jsonc)
D1_DATABASE_ID=

# Existing R2 bucket used for uploaded images / audio / covers
R2_BUCKET_NAME=

# Optional: editor key allowed to own the seeded official demo project
SEED_EDITOR_KEY=

# Optional: Microsoft Azure Speech (official free F0 tier, 0.5M neural chars/month)
# Create a "Speech" resource in the Azure portal, then set these as Pages secrets:
#   npx wrangler pages secret put AZURE_SPEECH_KEY --project-name=meme-stage
#   npx wrangler pages secret put AZURE_SPEECH_REGION --project-name=meme-stage
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
