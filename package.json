{
  "name": "meme-stage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MEME STAGE — interactive meme infinite canvas studio",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 execute meme-stage-db --local --file=./db/schema.sql",
    "db:remote": "wrangler d1 execute meme-stage-db --remote --file=./db/schema.sql",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=meme-stage --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "konva": "^10.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
