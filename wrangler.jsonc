{
  "name": "meme-stage",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meme-stage-db",
      "database_id": "a816ce15-f688-48c0-8b11-a9d37abbcc01"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kkmd"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // No AI secrets live here on purpose. Image generation uses the visitor's own
  // API key, stored in their browser and sent directly to the provider, so there is
  // nothing for the server to hold and nothing a visitor could spend.
  "vars": {}
}
