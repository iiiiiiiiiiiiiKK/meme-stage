{
  "name": "meme-stage",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meme-stage-db",
      "database_id": "a816ce15-f688-48c0-8b11-a9d37abbcc01"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kkmd"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  // Image generation gateway. IMAGE_API_KEY is a *secret* set via
  // `wrangler pages secret put IMAGE_API_KEY`; it must never be committed here.
  // IMGBB_API_KEY is likewise a secret. IMAGE_HOST=imgbb moves generated bytes to
  // that image host instead of growing the R2 bucket; unset keeps them in R2.
  // Both hosts serve the same /api/files/:id URL, so switching is invisible to the
  // canvas and to published pages.
  "vars": {
    "IMAGE_API_BASE_URL": "https://agent3.shyfai.cn",
    "IMAGE_API_MODELS": "gpt-image-2.5,gpt-image-2.6",
    "IMAGE_HOST": "imgbb"
  }
}
